{
	"name": "vscode-notes",
	"displayName": "Notes",
	"description": "Notes is a Markdown focused notes extension for Visual Studio Code that takes inspiration from Notational Velocity and nvAlt.",
	"version": "2.1.0",
	"publisher": "dionmunk",
	"license": "CC-BY-NC-4.0",
	"author": {
		"name": "Dion Munk",
		"url": "https://github.com/dionmunk"
	},
	"keywords": [
		"notes",
		"notational velocity",
		"nvalt"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/dionmunk/vscode-notes"
	},
	"homepage": "https://github.com/dionmunk/vscode-notes#readme",
	"bugs": {
		"url": "https://github.com/dionmunk/vscode-notes/issues"
	},
	"icon": "resources/icon.png",
	"engines": {
		"vscode": "^1.87.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./dist/extension",
	"contributes": {
		"configuration": {
			"title": "Notes",
			"properties": {
				"notes.notesLocation": {
					"type": "string",
					"default": "",
					"scope": "machine-overridable",
					"description": "Storage location for the Notes view, set in your user settings. A path starting with `~` is in your home folder. In a portable VS Code, a relative path is relative to the folder holding it, so the notes can travel with it. Not synced between machines. A value in a workspace's settings is used as that workspace's notes, use `notes.workspaceNotesLocation` for that instead."
				},
				"notes.workspaceNotesLocation": {
					"type": "string",
					"default": "",
					"description": "Storage location for the Workspace Notes view, usually set in the workspace settings. A relative path is relative to the first workspace folder, for example `.notes`. Set a relative path in your user settings to give every workspace that has that folder its own notes."
				},
				"notes.notesDefaultNoteExtension": {
					"type": "string",
					"default": "md",
					"description": "The default extension to use for new notes. (do not include the dot)"
				},
				"notes.notesExtensions": {
					"type": "string",
					"default": "*",
					"description": "A comma separated list of allowed extensions for notes. Use '*' (asterisk) to allow all file types. (do not include the dot or spaces)"
				},
				"notes.watchExternalChanges": {
					"type": "boolean",
					"default": true,
					"description": "Update the Notes view when notes are added, renamed or removed outside of this window, by a sync client or another editor for example."
				},
				"notes.watchIntervalSeconds": {
					"type": "number",
					"default": 5,
					"minimum": 2,
					"maximum": 60,
					"description": "How often, in seconds, the open folders are checked for changes made outside of this window while the Notes view is visible. File system events are used as well, but a synced folder, or a Windows folder seen from WSL, may never send any."
				}
			}
		},
		"commands": [
			{
				"command": "Notes.deleteNote",
				"title": "Delete Note",
				"icon": {
					"light": "resources/light/delete.svg",
					"dark": "resources/dark/delete.svg"
				}
			},
			{
				"command": "Notes.deleteFolder",
				"title": "Delete Folder",
				"icon": {
					"light": "resources/light/delete.svg",
					"dark": "resources/dark/delete.svg"
				}
			},
			{
				"command": "Notes.listNotes",
				"title": "List Notes",
				"category": "Notes"
			},
			{
				"command": "Notes.newNote",
				"title": "New Note",
				"category": "Notes",
				"icon": "$(new-file)"
			},
			{
				"command": "Notes.newFolder",
				"title": "New Folder",
				"category": "Notes",
				"icon": "$(new-folder)"
			},
			{
				"command": "Notes.newNoteInNotes",
				"title": "New Note",
				"category": "Notes",
				"icon": "$(new-file)"
			},
			{
				"command": "Notes.newFolderInNotes",
				"title": "New Folder",
				"category": "Notes",
				"icon": "$(new-folder)"
			},
			{
				"command": "Notes.newNoteInWorkspaceNotes",
				"title": "New Note",
				"category": "Notes",
				"icon": "$(new-file)"
			},
			{
				"command": "Notes.newFolderInWorkspaceNotes",
				"title": "New Folder",
				"category": "Notes",
				"icon": "$(new-folder)"
			},
			{
				"command": "Notes.searchNotes",
				"title": "Search Notes",
				"category": "Notes",
				"icon": "$(search)"
			},
			{
				"command": "Notes.searchInNotes",
				"title": "Search Notes",
				"category": "Notes",
				"icon": "$(search)"
			},
			{
				"command": "Notes.searchInWorkspaceNotes",
				"title": "Search Workspace Notes",
				"category": "Notes",
				"icon": "$(search)"
			},
			{
				"command": "Notes.searchInFolder",
				"title": "Search in Folder",
				"category": "Notes"
			},
			{
				"command": "Notes.refreshNotes",
				"title": "Refresh Notes",
				"category": "Notes",
				"icon": "$(refresh)"
			},
			{
				"command": "Notes.openPreview",
				"title": "Open Preview",
				"category": "Notes"
			},
			{
				"command": "Notes.renameNote",
				"title": "Rename Note",
				"icon": {
					"light": "resources/light/rename.svg",
					"dark": "resources/dark/rename.svg"
				}
			},
			{
				"command": "Notes.renameFolder",
				"title": "Rename Folder",
				"icon": {
					"light": "resources/light/rename.svg",
					"dark": "resources/dark/rename.svg"
				}
			},
			{
				"command": "Notes.move",
				"title": "Move To...",
				"category": "Notes"
			},
			{
				"command": "Notes.revealInOS",
				"title": "Reveal in File Explorer",
				"category": "Notes"
			},
			{
				"command": "Notes.setupNotes",
				"title": "Settings",
				"category": "Notes",
				"icon": "$(gear)"
			},
			{
				"command": "Notes.selectLocation",
				"title": "Select Storage Location",
				"category": "Notes"
			},
			{
				"command": "Notes.revealWorkspaceNotesInOS",
				"title": "Reveal in File Explorer",
				"category": "Notes"
			},
			{
				"command": "Notes.selectWorkspaceLocation",
				"title": "Select Workspace Notes Location",
				"category": "Notes"
			},
			{
				"command": "Notes.setUpWorkspaceNotes",
				"title": "Set Up Workspace Notes",
				"category": "Notes"
			},
			{
				"command": "Notes.createNotesFolder",
				"title": "Create Notes Folder",
				"category": "Notes"
			},
			{
				"command": "Notes.createWorkspaceNotesFolder",
				"title": "Create Workspace Notes Folder",
				"category": "Notes"
			}
		],
		"keybindings": [
			{
				"command": "Notes.listNotes",
				"key": "alt+l",
				"mac": "alt+l"
			},
			{
				"command": "Notes.newNote",
				"key": "alt+n",
				"mac": "alt+n"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "Notes.newNoteInWorkspaceNotes",
					"when": "view == workspaceNotes",
					"group": "navigation@1"
				},
				{
					"command": "Notes.newFolderInWorkspaceNotes",
					"when": "view == workspaceNotes",
					"group": "navigation@2"
				},
				{
					"command": "Notes.searchInWorkspaceNotes",
					"when": "view == workspaceNotes",
					"group": "navigation@3"
				},
				{
					"command": "Notes.refreshNotes",
					"when": "view == workspaceNotes",
					"group": "navigation@4"
				},
				{
					"command": "Notes.revealWorkspaceNotesInOS",
					"when": "view == workspaceNotes && (!remoteName || remoteName == wsl)",
					"group": "1_open@1"
				},
				{
					"command": "Notes.selectWorkspaceLocation",
					"when": "view == workspaceNotes",
					"group": "2_location@1"
				},
				{
					"command": "Notes.newNoteInNotes",
					"when": "view == notes",
					"group": "navigation@1"
				},
				{
					"command": "Notes.newFolderInNotes",
					"when": "view == notes",
					"group": "navigation@2"
				},
				{
					"command": "Notes.searchInNotes",
					"when": "view == notes",
					"group": "navigation@3"
				},
				{
					"command": "Notes.refreshNotes",
					"when": "view == notes",
					"group": "navigation@4"
				},
				{
					"command": "Notes.setupNotes",
					"when": "view == notes",
					"group": "navigation@5"
				},
				{
					"command": "Notes.revealInOS",
					"when": "view == notes && (!remoteName || remoteName == wsl)",
					"group": "1_open@1"
				},
				{
					"command": "Notes.setUpWorkspaceNotes",
					"when": "view == notes && workspaceFolderCount > 0 && !notes.workspaceNotesAvailable",
					"group": "2_location@1"
				}
			],
			"view/item/context": [
				{
					"command": "Notes.openPreview",
					"when": "view =~ /^(notes|workspaceNotes)$/ && viewItem == markdownNote && !hasCustomMarkdownPreview",
					"group": "navigation"
				},
				{
					"command": "Notes.renameNote",
					"when": "view =~ /^(notes|workspaceNotes)$/ && viewItem =~ /^(note|markdownNote)$/",
					"group": "1_modification@1"
				},
				{
					"command": "Notes.deleteNote",
					"when": "view =~ /^(notes|workspaceNotes)$/ && viewItem =~ /^(note|markdownNote)$/",
					"group": "1_modification@2"
				},
				{
					"command": "Notes.renameFolder",
					"when": "view =~ /^(notes|workspaceNotes)$/ && viewItem == folder",
					"group": "1_modification@1"
				},
				{
					"command": "Notes.deleteFolder",
					"when": "view =~ /^(notes|workspaceNotes)$/ && viewItem == folder",
					"group": "1_modification@2"
				},
				{
					"command": "Notes.move",
					"when": "view =~ /^(notes|workspaceNotes)$/ && viewItem =~ /^(note|markdownNote)$/",
					"group": "1_modification@3"
				},
				{
					"command": "Notes.move",
					"when": "view =~ /^(notes|workspaceNotes)$/ && viewItem == folder",
					"group": "1_modification@3"
				},
				{
					"command": "Notes.newNote",
					"when": "view =~ /^(notes|workspaceNotes)$/ && viewItem == folder",
					"group": "2_workspace@1"
				},
				{
					"command": "Notes.newFolder",
					"when": "view =~ /^(notes|workspaceNotes)$/ && viewItem == folder",
					"group": "2_workspace@2"
				},
				{
					"command": "Notes.searchInFolder",
					"when": "view =~ /^(notes|workspaceNotes)$/ && viewItem == folder",
					"group": "4_search@1"
				},
				{
					"command": "Notes.newNoteInNotes",
					"when": "view == notes && !viewItem",
					"group": "navigation@1"
				},
				{
					"command": "Notes.newFolderInNotes",
					"when": "view == notes && !viewItem",
					"group": "navigation@2"
				},
				{
					"command": "Notes.refreshNotes",
					"when": "view == notes && !viewItem",
					"group": "navigation@3"
				},
				{
					"command": "Notes.newNoteInWorkspaceNotes",
					"when": "view == workspaceNotes && !viewItem",
					"group": "navigation@1"
				},
				{
					"command": "Notes.newFolderInWorkspaceNotes",
					"when": "view == workspaceNotes && !viewItem",
					"group": "navigation@2"
				},
				{
					"command": "Notes.refreshNotes",
					"when": "view == workspaceNotes && !viewItem",
					"group": "navigation@3"
				},
				{
					"command": "Notes.revealInOS",
					"when": "view =~ /^(notes|workspaceNotes)$/ && viewItem =~ /^(note|markdownNote)$/ && (!remoteName || remoteName == wsl)",
					"group": "3_open@1"
				},
				{
					"command": "Notes.revealInOS",
					"when": "view =~ /^(notes|workspaceNotes)$/ && viewItem == folder && (!remoteName || remoteName == wsl)",
					"group": "3_open@1"
				}
			],
			"commandPalette": [
				{
					"command": "Notes.revealInOS",
					"when": "(!remoteName || remoteName == wsl)"
				},
				{
					"command": "Notes.selectWorkspaceLocation",
					"when": "workspaceFolderCount > 0"
				},
				{
					"command": "Notes.setUpWorkspaceNotes",
					"when": "workspaceFolderCount > 0 && !notes.workspaceNotesAvailable"
				},
				{
					"command": "Notes.newNoteInNotes",
					"when": "false"
				},
				{
					"command": "Notes.newFolderInNotes",
					"when": "false"
				},
				{
					"command": "Notes.newNoteInWorkspaceNotes",
					"when": "false"
				},
				{
					"command": "Notes.newFolderInWorkspaceNotes",
					"when": "false"
				},
				{
					"command": "Notes.revealWorkspaceNotesInOS",
					"when": "false"
				},
				{
					"command": "Notes.createNotesFolder",
					"when": "false"
				},
				{
					"command": "Notes.createWorkspaceNotesFolder",
					"when": "false"
				},
				{
					"command": "Notes.move",
					"when": "false"
				},
				{
					"command": "Notes.searchInNotes",
					"when": "false"
				},
				{
					"command": "Notes.searchInWorkspaceNotes",
					"when": "false"
				},
				{
					"command": "Notes.searchInFolder",
					"when": "false"
				},
				{
					"command": "Notes.renameNote",
					"when": "false"
				},
				{
					"command": "Notes.deleteNote",
					"when": "false"
				},
				{
					"command": "Notes.renameFolder",
					"when": "false"
				},
				{
					"command": "Notes.deleteFolder",
					"when": "false"
				},
				{
					"command": "Notes.openPreview",
					"when": "false"
				}
			]
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "vscode-notes",
					"title": "Notes",
					"icon": "resources/notes-light.svg"
				}
			]
		},
		"views": {
			"vscode-notes": [
				{
					"id": "workspaceNotes",
					"name": "Workspace Notes",
					"when": "notes.workspaceNotesAvailable"
				},
				{
					"id": "notes",
					"name": "Notes"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "notes",
				"contents": "To get started, you need to select a location to store your notes.\n[Select Location](command:Notes.selectLocation)",
				"when": "notes.locationState == unset || !notes.locationState && !config.notes.notesLocation"
			},
			{
				"view": "notes",
				"contents": "The notes storage location could not be found. Create the folder, or check the Storage Location setting and select another folder.\n[Create Folder](command:Notes.createNotesFolder)\n[Select Location](command:Notes.selectLocation)\n[Open Settings](command:Notes.setupNotes)",
				"when": "notes.locationState == missing"
			},
			{
				"view": "notes",
				"contents": "You don't have any notes yet.\n[New Note](command:Notes.newNoteInNotes)\n[New Folder](command:Notes.newFolderInNotes)",
				"when": "notes.locationState == empty"
			},
			{
				"view": "workspaceNotes",
				"contents": "The notes folder of this workspace could not be found.\n[Create Folder](command:Notes.createWorkspaceNotesFolder)\n[Select Location](command:Notes.selectWorkspaceLocation)",
				"when": "notes.workspaceLocationState == missing"
			},
			{
				"view": "workspaceNotes",
				"contents": "This workspace doesn't have any notes yet.\n[New Note](command:Notes.newNoteInWorkspaceNotes)\n[New Folder](command:Notes.newFolderInWorkspaceNotes)",
				"when": "notes.workspaceLocationState == empty"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "NODE_OPTIONS=--openssl-legacy-provider webpack --mode production",
		"compile": "tsc -p ./",
		"lint": "eslint src --ext ts",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"test": "node ./out/test/runTest.js",
		"webpack": "NODE_OPTIONS=--openssl-legacy-provider webpack --mode development",
		"webpack-dev": "NODE_OPTIONS=--openssl-legacy-provider webpack --mode development --watch",
		"test-compile": "tsc -p ./"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.6",
		"@types/node": "^20.11.0",
		"@types/vscode": "^1.87.0",
		"@typescript-eslint/eslint-plugin": "^8.71.1",
		"@typescript-eslint/parser": "^8.71.1",
		"@vscode/test-electron": "^3.1.0",
		"eslint": "^8.56.0",
		"glob": "^10.5.0",
		"mocha": "^12.0.3",
		"ts-loader": "^9.5.1",
		"typescript": "^5.3.3",
		"webpack": "^5.89.0",
		"webpack-cli": "^5.1.4"
	}
}
